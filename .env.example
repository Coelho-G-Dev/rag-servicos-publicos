# ==============================================================================
# RAG SERVIÇOS PÚBLICOS - VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
# ==============================================================================

# --- Inteligência Artificial (Google Gemini) ---
# OBTENÇÃO GRATUITA: Obtenha sua chave gratuitamente em: https://ai.google.dev/
# Sem esta chave, o sistema funcionará normalmente em modo de fallback,
# exibindo os dados recuperados diretamente do banco vetorial sem travamento.
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL_NAME=gemini-1.5-flash

# --- Segredo de Autenticação Interna entre Microsserviços ---
# Chave compartilhada para proteger o AI Service contra chamadas externas não autorizadas
INTERNAL_API_SECRET=super-secret-internal-key

# --- PostgreSQL com pgvector ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
DATABASE_URL=postgresql://rag_user:rag_password@postgres:5432/rag_db

# --- Gateway (Node.js) ---
PORT=3000
NODE_ENV=development
AI_SERVICE_URL=http://ai-service:8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- AI Service (Python) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
TOP_K_RESULTS=4
LOG_LEVEL=INFO
